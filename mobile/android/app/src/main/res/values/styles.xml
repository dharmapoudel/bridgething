<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Match the JS theme background so the status/nav bars and window
             blend with the app instead of showing the default gray. -->
        <item name="android:windowBackground">@color/app_chrome_bg</item>
        <item name="android:statusBarColor">@color/app_chrome_bg</item>
        <item name="android:navigationBarColor">@color/app_chrome_bg</item>
    </style>

</resources>
